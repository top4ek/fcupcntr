FROM golang:1.27-alpine AS builder

WORKDIR /src

ENV GO111MODULE=on \
  GOOS=linux \
  CGO_ENABLED=0 \
  GOFLAGS=-buildvcs=false

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
  --mount=type=cache,target=/root/.cache/go-build \
  go mod download && go mod verify

COPY . .

RUN --mount=type=cache,target=/go/pkg/mod \
  --mount=type=cache,target=/root/.cache/go-build \
  go build -trimpath -ldflags="-s -w" -o /out/fcupcntr ./cmd/fcupcntr

FROM alpine:3.22

RUN mkdir -p /data && chown 999:999 /data

WORKDIR /app

COPY --from=builder --chown=999:999 /out/fcupcntr /app/fcupcntr

USER 999:999

EXPOSE 8080

ENV PORT=8080 \
  DSN=/data/counters.db

ENTRYPOINT ["/app/fcupcntr"]
